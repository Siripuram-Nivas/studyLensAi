# StudyLens AI environment template.
# Copy this file to .env (project root) or backend/.env and fill in values.
# Never commit a real .env file or API key.

APP_NAME=StudyLens AI
ENVIRONMENT=development
API_PREFIX=/api

# SQLite by default. The path is resolved by SQLAlchemy.
# DATABASE_URL=sqlite:///./backend/studylens.db

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: openai_compatible | ollama | disabled
# "disabled" keeps ingestion and the UI fully usable without any AI calls.
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_INPUT_CHARS=12000
AI_TEMPERATURE=0.2
AI_JSON_MODE=true
AI_VISION_ENABLED=false
AI_STATUS_CACHE_SECONDS=20

# Upload and extraction limits.
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=400000
MIN_TEXT_CHARS=40
